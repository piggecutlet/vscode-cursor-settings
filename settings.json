{
  // defaultSettings.json 順

  // 日本語: CTRL + SHIFT + P → Configure Display Language

  // プライバシー
  "telemetry.telemetryLevel": "off", // VSCode
  "telemetry.feedback.enabled": false, // VSCode & Cursor

  "dotnetAcquisitionExtension.enableTelemetry": false,

  // 自動更新
  "update.enableWindowsBackgroundUpdates": false, // VSCode & Cursor
  // "update.mode": "none" だと勝手に削除される場合がある
  "update.mode": "manual", // VSCode & Cursor
  "update.showReleaseNotes": false, // VSCode & Cursor

  // 拡張機能
  "extensions.autoCheckUpdates": false, // VSCode & Cursor
  "extensions.autoUpdate": "off", // VSCode & Cursor
  // おすすめの拡張機能を非表示
  "extensions.ignoreRecommendations": true, // VSCode & Cursor

  // フォーマット
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit", // VSCode & Cursor
    // source.removeUnusedImports + source.sortImports
    "source.organizeImports": "explicit" // VSCode & Cursor
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode", // VSCode & Cursor
  "editor.formatOnSave": true, // VSCode & Cursor
  "[csharp]": {
    // Cursor の anysphere.csharp だとフォーマットが動かない
    // "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnType": false
  },

  "eslint.enable": true,

  // Copilot 非表示
  "chat.disableAIFeatures": true, // VSCode

  // フォント
  // 等幅フォント UDEVGothicJPDOC-Regular.ttf (エディタ用) と UDEVGothicNF-Regular.ttf (ターミナル用) を追加
  "editor.fontFamily": "'UDEV Gothic JPDOC','UDEV Gothic NF', Consolas, 'Courier New', monospace",

  // 以下は未ソート

  // Git
  // "git.autoRepositoryDetection": "subFolders",
  // 空コミット時に自動でステージング
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",
  "git.ignoreLimitWarning": true,
  // GitLensの代わり
  "git.blame.editorDecoration.enabled": true,
  // .gitディレクトリを表示
  "files.exclude": {
    "**/.git": false
  },

  // Hex Editor
  "workbench.editorAssociations": {
    "{hexdiff}:/**/*.*": "hexEditor.hexedit",
    "*.bytes": "hexEditor.hexedit",
    "*.dat": "hexEditor.hexedit",
    "*.data": "hexEditor.hexedit",
    "*.md": "vscode.markdown.editor",
    "*.plist": "hexEditor.hexedit",
    "*.so": "hexEditor.hexedit",
    "libfrida-gadget.*.so": "default"
  },

  "files.associations": {
    "*.smali": "shellscript",
    ".prettierrc.json5": "jsonc",
    "knip.jsonc": "jsonc",
    ".gitmessage.txt": "git-commit",
    "*.kts": "java",
    "*.ghostty": "shell",
    "hosts": "shellscript",
    "libfrida-gadget.config.so": "json"
  },

  // VSCodeに寄せる
  "workbench.sideBar.location": "left",

  // その他
  "workbench.colorTheme": "Cursor Dark (No Italic)",

  // package.json デバッグ 非表示
  "debug.javascript.codelens.npmScripts": "never",
  // C# x個の参照 を非表示
  "editor.codeLens": false,
  // コメントの最初に追加されるタブの数
  "editor.tabSize": 2,
  // ファイルのtabSizeを優先するか
  "editor.detectIndentation": false,
  // ASCII文字以外を強調表示
  "editor.unicodeHighlight.nonBasicASCII": false,
  // ハイフンで単語を区切らない
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",

  // 制限モード
  "security.workspace.trust.enabled": false,

  "workbench.startupEditor": "none",
  // コマンドパレット
  "window.commandCenter": true,

  // 改行で行を変更
  "markdown.preview.breaks": true,

  // 空白行
  // 末尾に改行
  "files.insertFinalNewline": true,
  // 有効にすると、ファイルの保存時に最終行以降の新しい行をトリミングします。
  "files.trimFinalNewlines": true,
  // 有効にすると、ファイルの保存時に末尾の空白をトリミングします。
  "files.trimTrailingWhitespace": true,

  "diffEditor.ignoreTrimWhitespace": false,

  // 縦線の色を階層ごとに変える
  "editor.guides.bracketPairs": true,

  "explorer.compactFolders": false,

  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "tsconfig.tsbuildinfo": true
  },

  // ファイル移動でインポート自動調整
  "js/ts.updateImportsOnFileMove.enabled": "always",

  "json.schemaDownload.enable": true,

  // デフォルト: 8
  "workbench.tree.indent": 16,
  // デフォルト: 12
  "terminal.integrated.fontSize": 16,

  "workbench.editor.titleScrollbarSizing": "large",

  // ターミナルコピー用
  "terminal.integrated.copyOnSelection": true,

  // 新デザインのモーダルで開くのを防ぐ
  "workbench.editor.useModal": "off",

  "editor.lightbulb.enabled": "off",
  "terminal.integrated.initialHint": false,
  "explorer.confirmDragAndDrop": false,

  // Claude
  "claudeCode.focusView": true,
  // CTRL + V を有効化
  "claudeCode.useTerminal": true,
  "claudeCode.environmentVariables": [
    { "name": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "value": "1" }
  ],

  // Cursor
  // markdown と plaintext で Cursor Tab を有効化
  "cursor.cpp.disabledLanguages": [], // Cursor
  "cursor.general.emailPrivacyEnabled": true, // Cursor
  "cursor.composer.shouldChimeAfterChatFinishes": true, // Cursor
  "cursor.composer.usageSummaryDisplay": "always", // Cursor
  "workbench.activityBar.orientation": "vertical", // Cursor

  // 以下新規
  "files.autoSave": "off"
}
