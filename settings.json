{
  // プライバシー
  "crashReporting.enabled": "off", // Cursor
  "dotnetAcquisitionExtension.enableTelemetry": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off", // VSCode

  // 自動更新
  "update.enableWindowsBackgroundUpdates": false,
  // 勝手に "update.mode" が消える場合がある
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  // 拡張機能
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,

  // フォーマット
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[csharp]": {
    // Cursor版 anysphere.csharp
    // "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnType": false
  },

  "eslint.enable": true,

  // VSCode
  "chat.disableAIFeatures": true,

  // Cursor
  // Cursor Tabをmarkdownとplaintextでも有効にする
  "cursor.cpp.disabledLanguages": [],
  // 使用量を表示
  "cursor.composer.usageSummaryDisplay": "always",
  "cursor.general.emailPrivacyEnabled": true,

  // Git
  // GitLensの代わり
  "git.blame.editorDecoration.enabled": true,
  // .gitディレクトリを表示
  "files.exclude": {
    "**/.git": false
  },

  // Hex Editor
  "workbench.editorAssociations": {
    "*.bytes": "hexEditor.hexedit",
    "*.dat": "hexEditor.hexedit",
    "*.plist": "hexEditor.hexedit",
    "*.so": "hexEditor.hexedit"
  },

  "files.associations": {
    "*.smali": "shellscript"
  },

  // VSCodeに寄せる
  "workbench.sideBar.location": "left",

  // その他
  "workbench.colorTheme": "Cursor Dark (No Italic)",

  // package.json デバッグ 非表示
  "debug.javascript.codelens.npmScripts": "never",
  // C# x個の参照 を非表示
  "editor.codeLens": false,
  // コメントの最初に追加されるタブの数
  "editor.tabSize": 2,
  // ファイルのtabSizeを優先するか
  "editor.detectIndentation": false,
  // ASCII文字以外を強調表示
  "editor.unicodeHighlight.nonBasicASCII": false,
  // ハイフンで単語を区切らない
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",

  // 制限モード
  "security.workspace.trust.enabled": false,
  // アクティビティバー 垂直
  "workbench.activityBar.orientation": "vertical", // Cursor
  "workbench.startupEditor": "none",
  // コマンドパレット
  "window.commandCenter": true,
  "extensions.ignoreRecommendations": true,
  "git.openRepositoryInParentFolders": "never",

  // 改行で行を変更
  "markdown.preview.breaks": true,

  // 空白行
  // 末尾に改行
  "files.insertFinalNewline": true,
  // 有効にすると、ファイルの保存時に最終行以降の新しい行をトリミングします。
  "files.trimFinalNewlines": true,
  // 有効にすると、ファイルの保存時に末尾の空白をトリミングします。
  "files.trimTrailingWhitespace": true,

  "diffEditor.ignoreTrimWhitespace": false,

  // 縦線の色を階層ごとに変える
  "editor.guides.bracketPairs": true,

  // フォント
  // 等幅フォント UDEVGothicJPDOC-Regular.ttf を追加
  "editor.fontFamily": "'UDEV Gothic JPDOC', Consolas, 'Courier New', monospace",

  "explorer.compactFolders": false,

  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "tsconfig.tsbuildinfo": true
  },

  // ファイル移動でインポート自動調整
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",

  "json.schemaDownload.enable": true,

  // デフォルト: 8
  "workbench.tree.indent": 16,
  // デフォルト: 12
  "terminal.integrated.fontSize": 16,

  // Mac ターミナルコピー用
  "terminal.integrated.copyOnSelection": true,
  "workbench.editor.titleScrollbarSizing": "large",

  // その他
  "editor.largeFileOptimizations": false
}
